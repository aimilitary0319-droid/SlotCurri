# docker compose 가 자동으로 읽는 파일입니다.
# `cp .env.example .env` 로 복사 후 값 수정하세요.

# 컨테이너 사용자 UID/GID (호스트와 맞추면 마운트한 파일 권한 문제 X)
# 호스트에서 `id -u`, `id -g` 결과를 적으면 됩니다.
USER_NAME=slotcurri
USER_UID=1000
USER_GID=1000

# 보일 GPU. 전체 사용 → all, 일부만 → "0,1"
NVIDIA_VISIBLE_DEVICES=all

# 호스트에서 노출할 포트 (충돌 시 변경)
JUPYTER_PORT=8888
TB_PORT=6006
